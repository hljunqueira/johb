{
  "version": 2,
  "buildCommand": "npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "env": {
    "REACT_APP_MODE": "admin",
    "REACT_APP_BACKEND_URL": "https://api.saladasoul.com",
      "REACT_APP_API_URL": "https://api.saladasoul.com/api"
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.saladasoul.com/api/$1" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
