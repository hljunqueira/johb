{
  "version": 2,
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "frontend/build",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.saladasoul.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "env": {
    "REACT_APP_BACKEND_URL": "https://api.saladasoul.com",
    "REACT_APP_API_URL": "https://api.saladasoul.com/api",
    "DISABLE_ESLINT_PLUGIN": "true",
    "CI": "false"
  }
}
