# Crontab para backups automáticos do Salada Soul
# Adicione ao crontab do usuário: crontab -e

# Variáveis de ambiente necessárias
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Configurações do banco
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saladasoul
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Diretórios
BACKUP_DIR=/opt/saladasoul/backups
UPLOADS_DIR=/opt/saladasoul/backend/uploads

# Retenção (dias)
BACKUP_RETENTION_DAYS=30

# ============================================
# BACKUPS AUTOMÁTICOS
# ============================================

# Backup diário do banco de dados às 2:00 AM
0 2 * * * cd /opt/saladasoul && /usr/bin/python3 scripts/backup_auto.py >> /var/log/saladasoul/backup.log 2>&1

# Backup completo (banco + uploads) aos domingos às 3:00 AM
0 3 * * 0 cd /opt/saladasoul && /usr/bin/python3 scripts/backup_auto.py --full >> /var/log/saladasoul/backup_full.log 2>&1

# Limpeza de backups antigos todo dia 1º do mês às 4:00 AM
0 4 1 * * cd /opt/saladasoul && /usr/bin/python3 scripts/backup_auto.py --cleanup >> /var/log/saladasoul/cleanup.log 2>&1

# ============================================
# MONITORAMENTO
# ============================================

# Verificação de saúde a cada 5 minutos
*/5 * * * * cd /opt/saladasoul && /usr/bin/python3 scripts/monitor_system.py --once >> /var/log/saladasoul/monitor.log 2>&1

# ============================================
# MANUTENÇÃO
# ============================================

# Rotação de logs semanal
0 0 * * 0 /usr/bin/logrotate -f /opt/saladasoul/config/logrotate.conf
